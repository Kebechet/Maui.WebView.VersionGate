<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--The gate only does something on Android, where the WebView updates apart from the OS. Every other
        platform consumes the plain net10.0 build, where UseWebViewVersionGate registers nothing, so the
        package needs no iOS or Mac workload and the unit tests can reference it directly.-->
    <TargetFrameworks>net10.0;net10.0-android</TargetFrameworks>
    <SingleProject>true</SingleProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <UseMaui>true</UseMaui>
    <RootNamespace>Kebechet.Maui.WebView.VersionGate</RootNamespace>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Label="NugetProperties">
    <Authors>Kebechet</Authors>
    <IsPackable>true</IsPackable>
    <PackageId>Kebechet.Maui.WebView.VersionGate</PackageId>
    <Description>Holds a .NET MAUI app behind an update dialog while the Android System WebView is too old to run it, and sends the user to the Play Store to update it.</Description>
    <PackageTags>maui;android;webview;blazor-hybrid;update</PackageTags>
    <RepositoryUrl>https://github.com/Kebechet/Maui.WebView.VersionGate</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Kebechet/Maui.WebView.VersionGate</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <RepositoryType>git</RepositoryType>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageIcon>icon.png</PackageIcon>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DeterministicSourcePaths Condition="'$(GITHUB_ACTIONS)' == 'true'">true</DeterministicSourcePaths>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Version>1.0.0</Version>
    <PackageReleaseNotes>Initial release</PackageReleaseNotes>
  </PropertyGroup>

  <!--No Microsoft.SourceLink.GitHub reference: Source Link ships in the .NET SDK since 8.0, and the 8.0.0 package
      brings Microsoft.Build.Tasks.Git 8.0.0 with a known vulnerability (NU1902).
      Microsoft.Maui.Controls is pinned to the first MAUI 10 release rather than $(MauiVersion): the package becomes
      a minimum for every consumer, and the workload version of whichever machine packs it would otherwise force a
      newer MAUI on apps that pin an older one.-->
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Maui.WebView.VersionGate.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
